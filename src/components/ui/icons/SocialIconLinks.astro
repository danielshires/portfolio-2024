---
/**
 * LinkedIn and GitHub icon links. Static external links, so this stays an Astro component.
 * Icon buttons follow the theme-toggle treatment (size, zinc tones, hover) without the rotate.
 */
import { aboutContent } from '../../../config/about'

interface Props {
  class?: string
  /** Mail icon link, same circle treatment as the social icons. */
  includeEmail?: boolean
}

const { class: className = 'gap-1', includeEmail = false } = Astro.props

const links = aboutContent.social.filter(
  (link) => link.label === 'LinkedIn' || link.label === 'GitHub'
)
const email = aboutContent.social.find((link) => link.label === 'Email')

const linkClass = [
  'inline-flex items-center justify-center rounded-full p-2',
  'border border-zinc-300 bg-zinc-50 text-zinc-700',
  'transition-all duration-200',
  'hover:scale-105 hover:border-zinc-400 hover:bg-zinc-100',
  'dark:border-zinc-600 dark:bg-zinc-800 dark:text-zinc-300',
  'dark:hover:border-zinc-500 dark:hover:bg-zinc-700',
  'outline-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2',
  'dark:focus-visible:ring-white',
  'active:scale-95',
].join(' ')
---

<div class:list={['flex items-center', className]}>
  {
    includeEmail && email && (
      <a href={email.href} aria-label='Get in touch' class={linkClass}>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          viewBox='0 0 24 24'
          width='20'
          height='20'
          fill='none'
          stroke='currentColor'
          stroke-width='1.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'>
          <path d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' />
        </svg>
      </a>
    )
  }
  {
    links.map((link) => (
      <a
        href={link.href}
        target='_blank'
        rel='noopener noreferrer'
        aria-label={link.label}
        class={linkClass}>
        {link.label === 'LinkedIn' ? (
          <svg
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            width='20'
            height='20'
            fill='currentColor'
            aria-hidden='true'>
            <path d='M6.94048 4.99993C6.94011 5.81424 6.44608 6.54702 5.69134 6.85273C4.9366 7.15845 4.07187 6.97605 3.5049 6.39155C2.93793 5.80705 2.78195 4.93715 3.1105 4.19207C3.43906 3.44699 4.18654 2.9755 5.00048 2.99993C6.08155 3.03238 6.94097 3.91837 6.94048 4.99993ZM7.00048 8.49993H3.00048V20.9999H7.00048V8.49993ZM13.0305 8.49993H9.03048V20.9999H13.0305V14.4299C13.0305 10.7699 17.6905 10.4299 17.6905 14.4299V20.9999H21.7005V13.0699C21.7005 6.89993 14.9405 7.12993 13.0305 10.1599V8.49993Z' />
          </svg>
        ) : (
          <svg
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            width='20'
            height='20'
            fill='currentColor'
            aria-hidden='true'>
            <path d='M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12' />
          </svg>
        )}
      </a>
    ))
  }
</div>
