---
// Components
import NavLink from '../../ui/buttons/NavLink.astro'
import ThemeToggle from '../../ui/buttons/ThemeToggle.tsx'
import SettingsTrigger from '../settings/SettingsTrigger.tsx'
import SocialIconLinks from '../../ui/icons/SocialIconLinks.astro'
import { getNavigationItems } from '../../../config/features'
import { navLinkActiveClass, navLinkInactiveClass } from '../../ui/text/styles'

const navigationItems = getNavigationItems()
const menuButtonLayoutClass =
  'md:hidden shrink-0 cursor-pointer appearance-none border-0 bg-transparent p-0 text-left'
---

<nav
  id='nav'
  class='fixed z-50 top-0 left-0 right-0 flex items-center justify-start theme-transition nav-transition border-b border-zinc-200/20 dark:border-zinc-800/20'>
  <div class='container mx-auto w-full px-8 lg:px-16'>
    <div class='relative'>
      <div class='flex min-w-0 items-center justify-between gap-8 pt-4 md:pt-6 pb-3'>
      <div class='flex min-w-0 flex-row items-center gap-4 md:gap-6'>
        <NavLink path='' target='' href='/'>Home</NavLink>
        <div class='hidden min-w-0 gap-6 md:flex md:flex-1'>
          {
            navigationItems.map((item) => (
              <NavLink path={item.path} target='_self' href={item.href}>
                {item.label}
              </NavLink>
            ))
          }
        </div>
      </div>
      <button
        type='button'
        id='nav-menu-button'
        class:list={[navLinkInactiveClass, menuButtonLayoutClass]}
        aria-expanded='false'
        aria-controls='nav-menu'
        data-menu-open-class={navLinkActiveClass}
        data-menu-closed-class={navLinkInactiveClass}
        data-menu-layout-class={menuButtonLayoutClass}>
        <span class='menu-text menu-text-open'>Menu</span>
        <span class='menu-text menu-text-close'>Close</span>
      </button>
      <div class='hidden shrink-0 items-center gap-2 md:flex md:gap-4'>
        <SocialIconLinks includeEmail class='gap-2' />
        <ThemeToggle client:load />
        <SettingsTrigger client:load />
      </div>
    </div>
    </div>
  </div>
</nav>

<!-- Full-page mobile menu overlay -->
<div
  id='nav-menu'
  class='nav-menu fixed inset-0 z-40 bg-white dark:bg-zinc-950 md:hidden'>
  <div class='container mx-auto flex h-full flex-col px-8 pt-20 pb-8'>
    <div class='nav-menu-section'>
      <span class='nav-menu-label mb-4 block text-sm font-medium text-zinc-500 dark:text-zinc-400'>Menu</span>
      <ul class='nav-menu-list flex flex-col items-start'>
        {
          navigationItems.map((item, index) => (
            <li class='nav-menu-item w-full' style={`--item-index: ${index}`}>
              <a 
                href={item.href}
                class='block py-2 text-2xl font-medium text-zinc-950 transition-colors hover:text-zinc-600 dark:text-zinc-50 dark:hover:text-zinc-300'
                data-swup-preload>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class='nav-menu-footer mt-auto flex items-center gap-3 border-t border-zinc-200 pt-6 dark:border-zinc-800'>
      <SocialIconLinks includeEmail class='gap-3' />
      <div class='ml-auto flex items-center gap-2'>
        <ThemeToggle client:load />
        <SettingsTrigger client:load />
      </div>
    </div>
  </div>
  </div>
</nav>

<style>
  @media (max-width: 768px) {
    nav {
      width: 100%;
      left: 0;
      margin: 0;
      border-radius: 0;
    }
  }

  .nav-transition {
    transition:
      opacity 0.3s ease-in-out,
      transform 0.3s ease-in-out;
  }

  .nav-hidden {
    opacity: 0;
    transform: translateY(-20px);
    pointer-events: none;
  }

  /* Full-page mobile menu */
  .nav-menu {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 0.2s ease-out,
      visibility 0s linear 0.2s;
  }

  .nav-menu[data-open='true'] {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 0.25s ease-out,
      visibility 0s linear 0s;
  }

  /* Section label animation */
  .nav-menu-label {
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  .nav-menu[data-open='true'] .nav-menu-label {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.05s;
  }

  /* Staggered menu item animations */
  .nav-menu-item {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.25s ease-out,
      transform 0.25s ease-out;
  }

  .nav-menu[data-open='true'] .nav-menu-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(0.04s * var(--item-index, 0) + 0.08s);
  }

  /* Footer animation */
  .nav-menu-footer {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  .nav-menu[data-open='true'] .nav-menu-footer {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.25s;
  }

  /* Menu button text transition */
  #nav-menu-button {
    position: relative;
    min-width: 3rem;
  }

  #nav-menu-button .menu-text {
    display: inline-block;
    transition: opacity 0.15s ease-out, transform 0.15s ease-out;
  }

  #nav-menu-button[aria-expanded='true'] .menu-text-open {
    opacity: 0;
    transform: translateY(-4px);
    position: absolute;
  }

  #nav-menu-button[aria-expanded='false'] .menu-text-close {
    opacity: 0;
    transform: translateY(4px);
    position: absolute;
  }

  /* Lock body scroll when menu is open */
  :global(body.nav-menu-open) {
    overflow: hidden;
  }
</style>

<script>
  type NavRuntime = {
    scrollHandler: (() => void) | null
    menuAbort: AbortController | null
    lifecycleBound: boolean
  }

  const navWindow = window as Window & { __portfolioNav?: NavRuntime }
  if (!navWindow.__portfolioNav) {
    navWindow.__portfolioNav = {
      scrollHandler: null,
      menuAbort: null,
      lifecycleBound: false,
    }
  }
  const navRuntime = navWindow.__portfolioNav

  function initNav() {
    const nav = document.getElementById('nav')
    if (!nav) return

    if (navRuntime.scrollHandler) {
      window.removeEventListener('scroll', navRuntime.scrollHandler)
      navRuntime.scrollHandler = null
    }

    if (navRuntime.menuAbort) {
      navRuntime.menuAbort.abort()
      navRuntime.menuAbort = null
    }

    const menuButton = nav.querySelector<HTMLButtonElement>('#nav-menu-button')
    const menuPanel = document.getElementById('nav-menu')
    const menuAbort = new AbortController()
    navRuntime.menuAbort = menuAbort
    const signal = menuAbort.signal

    function setMenuOpen(open: boolean, returnFocus = false) {
      if (!menuButton || !menuPanel) return

      const wasOpen = menuButton.getAttribute('aria-expanded') === 'true'
      menuPanel.setAttribute('data-open', open ? 'true' : 'false')
      menuButton.setAttribute('aria-expanded', open ? 'true' : 'false')

      if (open) {
        document.body.classList.add('nav-menu-open')
      } else {
        document.body.classList.remove('nav-menu-open')
      }

      const stateClass = open
        ? menuButton.dataset.menuOpenClass
        : menuButton.dataset.menuClosedClass
      const layoutClass = menuButton.dataset.menuLayoutClass ?? ''
      menuButton.className = [stateClass, layoutClass].filter(Boolean).join(' ')

      if (!open && returnFocus && wasOpen) menuButton.focus()
    }

    setMenuOpen(false)

    menuButton?.addEventListener(
      'click',
      () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true'
        setMenuOpen(!open)
      },
      { signal }
    )

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') return
        setMenuOpen(false, true)
      },
      { signal }
    )

    document.addEventListener('portfolio:close-nav-menu', () => setMenuOpen(false), { signal })

    menuPanel?.addEventListener(
      'click',
      (event) => {
        const target = event.target
        if (!(target instanceof Element) || !target.closest('a')) return
        setMenuOpen(false)
      },
      { signal }
    )

    const desktopQuery = window.matchMedia('(min-width: 768px)')
    desktopQuery.addEventListener(
      'change',
      () => {
        if (desktopQuery.matches) setMenuOpen(false)
      },
      { signal }
    )

    let lastScrollY = window.scrollY
    const DIRECTION_THRESHOLD_PX = 8
    const BOTTOM_SLACK_PX = 4
    const BOTTOM_SCROLL_UP_MIN_PX = 28

    function updateNav() {
      if (!nav) return
      if (menuButton?.getAttribute('aria-expanded') === 'true') return

      const currentScrollY = window.scrollY
      const delta = currentScrollY - lastScrollY
      const maxScroll = Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight
      )
      const nearBottom = currentScrollY >= maxScroll - BOTTOM_SLACK_PX

      if (currentScrollY <= 1) {
        nav.classList.remove('nav-hidden')
        lastScrollY = currentScrollY
        return
      }

      if (Math.abs(delta) < DIRECTION_THRESHOLD_PX) {
        lastScrollY = currentScrollY
        return
      }

      if (nearBottom && delta < 0 && Math.abs(delta) < BOTTOM_SCROLL_UP_MIN_PX) {
        lastScrollY = currentScrollY
        return
      }

      if (delta > 0) {
        nav.classList.add('nav-hidden')
      } else {
        nav.classList.remove('nav-hidden')
      }

      lastScrollY = currentScrollY
    }

    navRuntime.scrollHandler = updateNav
    window.addEventListener('scroll', navRuntime.scrollHandler, { passive: true })
  }

  initNav()

  if (!navRuntime.lifecycleBound) {
    navRuntime.lifecycleBound = true
    document.addEventListener('astro:after-swap', initNav)
    document.addEventListener('astro:page-load', initNav)
    document.addEventListener('swup:content:replace', initNav)
  }
</script>
