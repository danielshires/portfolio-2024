---
import {
  aboutContent,
  experiencePeriod,
  experienceSpan,
} from '../../../config/about'
import SectionHeading from '../../ui/text/SectionHeading.astro'
import { linkFocusRingClass, textLinkClass } from '../../ui/text/styles'

interface Props {
  class?: string
}

const { class: className } = Astro.props

const canExpand = aboutContent.experience.some((entry) => entry.roles.length > 1)

const dateClass = 'shrink-0 text-sm tabular-nums text-zinc-500 dark:text-zinc-400'
const orgClass = 'font-semibold text-zinc-900 dark:text-zinc-100'
const roleClass = 'font-normal text-zinc-600 dark:text-zinc-400'
const controlClass = `inline-flex items-center gap-1.5 text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 ${linkFocusRingClass}`

const tileClass =
  'relative z-10 box-border size-7 shrink-0 rounded-md border border-zinc-200 bg-white dark:border-zinc-600'
const tileInnerClass = 'absolute inset-px overflow-hidden rounded-[4px]'
---

<section
  class:list={['group/experience', className]}
  data-experience
  data-open='false'
  aria-labelledby='experience-heading'>
  <SectionHeading id='experience-heading'>
    Experience
    <div slot='actions' class='flex items-center gap-3'>
      <a href={aboutContent.cv.href} download='daniel-shires-cv.md' class={controlClass}>
        <svg
          class='size-3.5'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'>
          <path d='M12 3v12' />
          <path d='m7 11 5 5 5-5' />
          <path d='M4 21h16' />
        </svg>
        {aboutContent.cv.label}
      </a>
      {
        canExpand && (
          <>
            <span aria-hidden='true' class='h-3 w-px bg-zinc-300 dark:bg-zinc-700' />
            <button
              type='button'
              data-experience-toggle
              aria-expanded='false'
              aria-controls='experience-history'
              class={controlClass}>
              <span class='group-data-[open=true]/experience:hidden'>All</span>
              <span class='hidden group-data-[open=true]/experience:inline'>Less</span>
              <svg
                class='size-3.5 motion-safe:transition-transform motion-safe:duration-200 group-data-[open=true]/experience:rotate-180'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'>
                <path d='m6 9 6 6 6-6' />
              </svg>
            </button>
          </>
        )
      }
    </div>
  </SectionHeading>

  <ul id='experience-history' class='flex flex-col'>
    {
      aboutContent.experience.map((entry) => {
        const latest = entry.roles[0]
        if (!latest) return null
        const earlier = entry.roles.slice(1)
        const multiple = earlier.length > 0
        const initials = entry.monogram ?? entry.organization.slice(0, 2)
        return (
          <li class='relative grid grid-cols-[1.75rem_minmax(0,1fr)] items-start sm:items-center gap-x-3 py-2.5'>
            <span class={tileClass} aria-hidden='true'>
              <span class:list={['flex items-center justify-center', tileInnerClass]}>
                {entry.logo ? (
                  <img
                    src={entry.logo}
                    alt=''
                    width='28'
                    height='28'
                    class='size-full object-contain'
                    loading='lazy'
                    decoding='async'
                  />
                ) : (
                  <span class='text-[11px] font-medium tracking-tight text-zinc-800'>{initials}</span>
                )}
              </span>
            </span>
            <div class='flex min-w-0 items-baseline justify-between gap-x-3'>
              <p class='min-w-0 leading-snug'>
                {entry.organizationHref ? (
                  <a
                    href={entry.organizationHref}
                    target='_blank'
                    rel='noopener noreferrer'
                    class={`${orgClass} ${textLinkClass} ${linkFocusRingClass}`}>
                    {entry.organization}
                  </a>
                ) : (
                  <span class={orgClass}>{entry.organization}</span>
                )}
                <span class={`${roleClass} block sm:inline`}>{latest.title}</span>
              </p>
              <span class={dateClass}>
                {multiple ? (
                  <>
                    <span class='group-data-[open=true]/experience:hidden'>
                      {experienceSpan(entry.roles)}
                    </span>
                    <span class='hidden group-data-[open=true]/experience:inline'>
                      {experiencePeriod(latest.start, latest.end)}
                    </span>
                  </>
                ) : (
                  experiencePeriod(latest.start, latest.end)
                )}
              </span>
            </div>
            {multiple && (
              <span
                aria-hidden='true'
                class='pointer-events-none absolute bottom-3 left-[calc(0.875rem-0.5px)] top-9 hidden w-px bg-zinc-200 group-data-[open=true]/experience:block dark:bg-zinc-700'
              />
            )}
            {multiple && (
              <div
                data-previous
                inert
                aria-hidden='true'
                class='col-span-2 grid grid-rows-[0fr] motion-safe:transition-[grid-template-rows] motion-safe:duration-200 motion-safe:ease-out group-data-[open=true]/experience:grid-rows-[1fr]'>
                <div class='overflow-hidden'>
                  <ul>
                    {earlier.map((role) => (
                      <li class='grid grid-cols-[1.75rem_minmax(0,1fr)] items-baseline gap-x-3 py-1.5'>
                        <span aria-hidden='true' class='relative z-10 flex justify-center'>
                          <span class='size-1.5 rounded-full bg-zinc-300 ring-2 ring-zinc-50 dark:bg-zinc-600 dark:ring-zinc-900' />
                        </span>
                        <div class='flex min-w-0 items-baseline justify-between gap-x-3'>
                          <p class={`min-w-0 leading-snug ${roleClass}`}>{role.title}</p>
                          <span class={dateClass}>{experiencePeriod(role.start, role.end)}</span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        )
      })
    }
  </ul>
</section>
