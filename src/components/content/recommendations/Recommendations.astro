---
import { recommendations } from '../../../config/recommendations'
import SectionHeading from '../../ui/text/SectionHeading.astro'

interface Props {
  class?: string
  /** Limit the number of recommendations shown (for homepage preview) */
  limit?: number
  /** Show a link to the full recommendations section */
  href?: string
}

const { class: className, limit, href } = Astro.props

const displayedRecommendations = limit ? recommendations.slice(0, limit) : recommendations

const quoteClass = 'text-base leading-relaxed text-zinc-700 dark:text-zinc-300'
const nameClass = 'font-semibold text-zinc-900 dark:text-zinc-100'
const metaClass = 'text-sm text-zinc-500 dark:text-zinc-400'
---

<section class:list={[className]} aria-labelledby='recommendations-heading'>
  <SectionHeading id='recommendations-heading' href={href}>Recommendations</SectionHeading>

  <ul class='flex flex-col gap-8'>
    {
      displayedRecommendations.map((rec) => (
        <li class='relative'>
          <blockquote class='flex flex-col gap-3'>
            <svg
              class='absolute -left-1 -top-1 size-6 text-zinc-200 dark:text-zinc-700'
              fill='currentColor'
              viewBox='0 0 32 32'
              aria-hidden='true'>
              <path d='M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z' />
            </svg>
            <p class={`${quoteClass} pl-7`}>{rec.quote}</p>
            <footer class='flex flex-col gap-0.5 pl-7'>
              <cite class={`${nameClass} not-italic`}>{rec.name}</cite>
              <span class={metaClass}>
                {rec.role} at {rec.organization}
              </span>
            </footer>
          </blockquote>
        </li>
      ))
    }
  </ul>
</section>
