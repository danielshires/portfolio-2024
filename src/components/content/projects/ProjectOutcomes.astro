---
import Text from '../../ui/text/Text.astro'
import { gridGutterClass, sectionLabelTypographyClass } from '../../ui/text/styles'

interface Props {
  outcomes: string[] | {
    statistic: string;
    description: string;
  }[];
}

const { outcomes } = Astro.props

// Normalize outcomes to handle both string arrays and object arrays
const normalizedOutcomes = Array.isArray(outcomes)
  ? outcomes.map(outcome => {
      if (typeof outcome === 'string') {
        return { statistic: outcome, description: '' }
      }
      return outcome
    })
  : []

// The case study rows put the heading in four columns and the writing in the remaining eight.
// These figures use that same split, so the first number starts on the writing column.
const figureColumns =
  normalizedOutcomes.length >= 4
    ? 'sm:grid-cols-2 lg:grid-cols-4'
    : normalizedOutcomes.length === 3
      ? 'sm:grid-cols-2 lg:grid-cols-3'
      : normalizedOutcomes.length === 2
        ? 'sm:grid-cols-2'
        : 'grid-cols-1'
---

<section
  class={`grid grid-cols-1 lg:grid-cols-12 gap-y-8 ${gridGutterClass} py-12 md:py-16 border-t border-zinc-200 dark:border-zinc-800`}
  aria-labelledby='case-study-00'>
  <div class='lg:col-span-4'>
    <p class={sectionLabelTypographyClass}>00</p>
    <Text variant='h2' id='case-study-00' class='mt-3'>
      Impact
    </Text>
  </div>

  <div class={`grid grid-cols-1 content-start gap-y-10 lg:col-span-8 ${figureColumns} ${gridGutterClass}`}>
    {normalizedOutcomes.map((outcome) => (
      <div>
        <p class="text-5xl md:text-6xl font-normal tracking-tight leading-none text-zinc-900 dark:text-zinc-100">
          {outcome.statistic}
        </p>
        {outcome.description && (
          <p class="mt-3 max-w-[16rem] text-base leading-snug text-zinc-600 dark:text-zinc-400">
            {outcome.description}
          </p>
        )}
      </div>
    ))}
  </div>
</section>
