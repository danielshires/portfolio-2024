---
import type { PortableTextBlock } from '@portabletext/types'
import { PortableText } from 'astro-portabletext'
import Text from '../../ui/text/Text.astro'
import { gridGutterClass } from '../../ui/text/styles'
import CaseStudyImage from './CaseStudyImage.astro'

interface Props {
  number: string
  heading: string
  body?: PortableTextBlock[]
  /** "Fig. 01"-style labels for captioned images, keyed by block `_key`. */
  figureLabels?: Map<string, string>
}

const { number, heading, body, figureLabels } = Astro.props
const hasBody = Array.isArray(body) && body.length > 0
const labelledBody = hasBody
  ? body.map((block) => {
      const label = block._key ? figureLabels?.get(block._key) : undefined
      return label ? { ...block, figureLabel: label } : block
    })
  : []

const portableTextComponents = {
  type: {
    image: CaseStudyImage,
  },
}

const headingId = `case-study-${number}`
---

{
  hasBody && (
    <section
      class={`grid grid-cols-1 lg:grid-cols-12 gap-y-4 ${gridGutterClass} py-12 md:py-16 border-t border-zinc-200 dark:border-zinc-800`}
      aria-labelledby={headingId}>
      <div class='lg:col-span-4'>
        <div class='lg:sticky lg:top-32'>
          <Text variant='caption' color='muted' class='font-mono mb-2'>
            {number}
          </Text>
          <Text variant='h4' id={headingId}>
            {heading}
          </Text>
        </div>
      </div>
      <div class='lg:col-span-8'>
        <div class='prose prose-lg dark:prose-invert max-w-none'>
          <PortableText value={labelledBody} components={portableTextComponents} />
        </div>
      </div>
    </section>
  )
}
