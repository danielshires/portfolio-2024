---
import type { PortableTextBlock } from '@portabletext/types'
import { PortableText } from 'astro-portabletext'
import Text from '../../ui/text/Text.astro'
import { gridGutterClass, sectionLabelTypographyClass } from '../../ui/text/styles'
import CaseStudyImage from './CaseStudyImage.astro'

interface Props {
  number: string
  heading: string
  body?: PortableTextBlock[]
  /** "Fig. 01"-style labels for captioned images, keyed by block `_key`. */
  figureLabels?: Map<string, string>
}

const { number, heading, body, figureLabels } = Astro.props
const hasBody = Array.isArray(body) && body.length > 0
const labelledBody = hasBody
  ? body.map((block) => {
      const label = block._key ? figureLabels?.get(block._key) : undefined
      return label ? { ...block, figureLabel: label } : block
    })
  : []

const portableTextComponents = {
  type: {
    image: CaseStudyImage,
  },
}

const headingId = `case-study-${number}`
---

{
  hasBody && (
    <section
      class={`grid grid-cols-1 lg:grid-cols-12 gap-y-8 ${gridGutterClass} py-12 md:py-16 border-t border-zinc-200 dark:border-zinc-800`}
      aria-labelledby={headingId}>
      <div class='lg:col-span-4'>
        <div class='lg:sticky lg:top-32'>
          <p class={sectionLabelTypographyClass}>{number}</p>
          <Text variant='h2' id={headingId} class='mt-3'>
            {heading}
          </Text>
        </div>
      </div>
      <div class='lg:col-span-8'>
        <div class='prose dark:prose-invert max-w-none prose-p:text-lg prose-p:leading-relaxed prose-li:text-lg prose-li:leading-relaxed prose-headings:font-normal prose-headings:tracking-tight prose-h3:text-xl md:prose-h3:text-2xl prose-h4:text-xl md:prose-h4:text-2xl prose-blockquote:border-zinc-300 prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-xl md:prose-blockquote:text-2xl prose-blockquote:leading-snug dark:prose-blockquote:border-zinc-700 dark:prose-blockquote:text-zinc-100'>
          <PortableText value={labelledBody} components={portableTextComponents} />
        </div>
      </div>
    </section>
  )
}
