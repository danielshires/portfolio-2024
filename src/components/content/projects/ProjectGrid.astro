---
import ProjectCard from './ProjectCard.astro'
import { urlFor, projectListHref, isExternalProject } from '../../../lib/sanity'
import type { Project } from '../../../lib/sanity'
import SectionHeading from '../../ui/text/SectionHeading.astro'
import { stackBelowHeroClass } from '../../ui/text/styles'

interface Props {
  projects: Project[]
  variant?: 'card' | 'text' | 'featured'
  /** When `variant` is `text`, show project subtitle after the title (default true). */
  showSubtitle?: boolean
}

const { projects, variant = 'card', showSubtitle = true } = Astro.props

// Transform Sanity projects to match ProjectCard interface.
// Text and featured variants (homepage) use project name + subtitle.
// Card variant keeps the existing client-as-headline layout.
const transformedProjects = projects.map((project) => {
  const usesTitle = variant === 'text' || variant === 'featured'
  const headline = usesTitle
    ? project.title
    : project.client || project.tags?.[0] || project.title
  const sub = project.subtitle

  return {
    projectImage: {
      src: project.heroImage
        ? urlFor(project.heroImage)
            .width(800)
            .height(600)
            .quality(85)
            .auto('format')
            .fit('max')
            .url()
        : '/images/jpg/background.webp',
      alt: project.title + ' project showcase',
      width: 800,
      height: 600,
    },
    title: headline,
    heading: sub,
    description: sub,
    external: isExternalProject(project),
    projectUrl: projectListHref(project),
  }
})
---

{
  variant === 'featured' ? (
    <section class:list={['flex flex-col max-w-[100vw]', stackBelowHeroClass]} aria-label='Projects'>
      <SectionHeading href='/projects'>Projects</SectionHeading>
      <div class='grid grid-cols-1 md:grid-cols-3 gap-8'>
        {transformedProjects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>
  ) : variant === 'text' ? (
    <section class:list={['flex flex-col max-w-[100vw]', stackBelowHeroClass]}>
      <SectionHeading href='/projects'>Projects</SectionHeading>
      <div class='flex flex-col'>
        {transformedProjects.map((project) => (
          <ProjectCard variant='text' showSubtitle={showSubtitle} {...project} />
        ))}
      </div>
    </section>
  ) : (
    <section class:list={['flex flex-col max-w-[100vw]', stackBelowHeroClass]}>
      <SectionHeading>Recent projects</SectionHeading>
      <div class='grid grid-cols-1 md:grid-cols-6 lg:grid-cols-3 gap-8'>
        {transformedProjects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>
  )
}
