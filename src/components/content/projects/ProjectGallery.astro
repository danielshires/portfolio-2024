---
import GalleryCaption from './GalleryCaption.astro'
import { urlFor } from '../../../lib/sanity'
import type { ProjectGalleryImage, ProjectGalleryRow } from '../../../lib/sanity'

interface Props {
  rows?: ProjectGalleryRow[]
}

const { rows = [] } = Astro.props

type RenderRow = {
  key: string
  kind: 'single' | 'pair'
  images: ProjectGalleryImage[]
}

function withAsset(image?: ProjectGalleryImage): image is ProjectGalleryImage {
  return Boolean(image?.asset)
}

const renderRows: RenderRow[] = []

rows.forEach((row, index) => {
  const key = row._key || String(index)
  if (row._type === 'imagePair') {
    const sides = [row.left, row.right].filter(withAsset)
    if (sides.length === 2) {
      renderRows.push({ key, kind: 'pair', images: sides })
    } else if (sides.length === 1) {
      renderRows.push({ key, kind: 'single', images: sides })
    }
    return
  }
  if (withAsset(row)) {
    renderRows.push({ key, kind: 'single', images: [row] })
  }
})

function imageUrl(image: ProjectGalleryImage, kind: 'single' | 'pair') {
  const builder = urlFor(image).quality(90).auto('format')
  if (kind === 'pair') {
    return builder.width(1600).height(1600).fit('crop').url()
  }
  return builder.width(3840).fit('max').url()
}

function hasCaption(image: ProjectGalleryImage) {
  return Boolean(image.heading?.trim() || image.caption?.trim())
}

/** Hairline keeps near-white artwork from merging into the light page; dark mode needs no edge. */
const imageFrameClass = 'block w-full rounded-2xl ring-1 ring-zinc-900/[0.07] md:rounded-3xl dark:ring-0'

const figureLabels = new Map<ProjectGalleryImage, string>()
renderRows
  .flatMap((row) => row.images)
  .filter(hasCaption)
  .forEach((image, index) => figureLabels.set(image, `Fig. ${String(index + 1).padStart(2, '0')}`))
---

{
  renderRows.length > 0 && (
    <section class='col-span-full' aria-label='Project gallery'>
      <div class='space-y-12 md:space-y-20'>
        {renderRows.map((row) => (
          <div class={row.kind === 'pair' ? 'grid grid-cols-1 gap-y-10 md:grid-cols-2 md:gap-x-8' : undefined}>
            {row.images.map((image) => (
              <figure>
                <img
                  src={imageUrl(image, row.kind)}
                  alt={image.alt || ''}
                  class={`${imageFrameClass} ${row.kind === 'pair' ? 'aspect-square object-cover' : 'h-auto'}`}
                  loading='lazy'
                  decoding='async'
                />
                {figureLabels.has(image) && (
                  <GalleryCaption
                    layout={row.kind}
                    label={figureLabels.get(image)!}
                    heading={image.heading}
                    caption={image.caption}
                  />
                )}
              </figure>
            ))}
          </div>
        ))}
      </div>
    </section>
  )
}
