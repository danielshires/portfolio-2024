---
import GalleryCaption from './GalleryCaption.astro'
import { galleryRowImages, urlFor } from '../../../lib/sanity'
import { gridGutterClass } from '../../ui/text/styles'
import type { ProjectGalleryImage, ProjectGalleryRow } from '../../../lib/sanity'

interface Props {
  rows?: ProjectGalleryRow[]
  tint?: string
}

const { rows = [], tint } = Astro.props
const brandTint = tint && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(tint) ? tint : undefined

type RowKind = 'single' | 'pair' | 'trio'

type RenderRow = {
  key: string
  kind: RowKind
  images: ProjectGalleryImage[]
}

const kindByCount: Record<number, RowKind> = { 1: 'single', 2: 'pair', 3: 'trio' }

const renderRows: RenderRow[] = rows.flatMap((row, index) => {
  const images = galleryRowImages(row)
  const kind = kindByCount[images.length]
  return kind ? [{ key: row._key || String(index), kind, images }] : []
})

const rowGridClass: Record<RowKind, string | undefined> = {
  single: undefined,
  pair: `grid grid-cols-1 gap-y-10 md:grid-cols-2 ${gridGutterClass}`,
  trio: `grid grid-cols-1 gap-y-10 md:grid-cols-3 ${gridGutterClass}`,
}

function imageUrl(image: ProjectGalleryImage, kind: RowKind) {
  const builder = urlFor(image).quality(90).auto('format')
  if (kind === 'single') {
    return builder.width(3840).fit('max').url()
  }
  return builder.width(1600).height(1600).fit('crop').url()
}

function hasCaption(image: ProjectGalleryImage) {
  return Boolean(image.heading?.trim() || image.caption?.trim())
}

/** Hairline keeps near-white artwork from merging into the light page; dark mode needs no edge. */
const imageFrameClass = 'block w-full rounded-2xl ring-1 ring-zinc-900/[0.07] md:rounded-3xl dark:ring-0'

const surfaceClasses = {
  neutral: 'bg-zinc-100 dark:bg-zinc-900',
  brand:
    'bg-[color-mix(in_srgb,var(--gallery-tint)_10%,white)] dark:bg-[color-mix(in_srgb,var(--gallery-tint)_18%,#18181b)]',
}

function surfaceClass(image: ProjectGalleryImage) {
  if (image.surface === 'brand') return brandTint ? surfaceClasses.brand : surfaceClasses.neutral
  if (image.surface === 'neutral') return surfaceClasses.neutral
  return ''
}

const figureLabels = new Map<ProjectGalleryImage, string>()
renderRows
  .flatMap((row) => row.images)
  .filter(hasCaption)
  .forEach((image, index) => figureLabels.set(image, `Fig. ${String(index + 1).padStart(2, '0')}`))
---

{
  renderRows.length > 0 && (
    <section
      class='col-span-full'
      aria-label='Project gallery'
      style={brandTint ? `--gallery-tint: ${brandTint}` : undefined}>
      <div class='space-y-12 md:space-y-20'>
        {renderRows.map((row) => (
          <div class={rowGridClass[row.kind]}>
            {row.images.map((image) => (
              <figure>
                <img
                  src={imageUrl(image, row.kind)}
                  alt={image.alt || ''}
                  class={`${imageFrameClass} ${surfaceClass(image)} ${row.kind === 'single' ? 'h-auto' : 'aspect-square object-cover'}`}
                  loading='lazy'
                  decoding='async'
                />
                {figureLabels.has(image) && (
                  <GalleryCaption
                    layout={row.kind === 'single' ? 'single' : 'pair'}
                    label={figureLabels.get(image)!}
                    heading={image.heading}
                    caption={image.caption}
                  />
                )}
              </figure>
            ))}
          </div>
        ))}
      </div>
    </section>
  )
}
