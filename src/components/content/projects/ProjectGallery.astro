---
import Text from '../../ui/text/Text.astro'
import { urlFor } from '../../../lib/sanity'
import type { ProjectGalleryImage, ProjectGalleryRow } from '../../../lib/sanity'

interface Props {
  rows?: ProjectGalleryRow[]
}

// Sanity returns null, not undefined, when a project has no gallery images.
const rows = Astro.props.rows ?? []

type RenderRow = {
  key: string
  kind: 'single' | 'pair'
  images: ProjectGalleryImage[]
}

function withAsset(image?: ProjectGalleryImage): image is ProjectGalleryImage {
  return Boolean(image?.asset)
}

const renderRows: RenderRow[] = []

rows.forEach((row, index) => {
  const key = row._key || String(index)
  if (row._type === 'imagePair') {
    const sides = [row.left, row.right].filter(withAsset)
    if (sides.length === 2) {
      renderRows.push({ key, kind: 'pair', images: sides })
    } else if (sides.length === 1) {
      renderRows.push({ key, kind: 'single', images: sides })
    }
    return
  }
  if (withAsset(row)) {
    renderRows.push({ key, kind: 'single', images: [row] })
  }
})

function imageUrl(image: ProjectGalleryImage, kind: 'single' | 'pair') {
  const builder = urlFor(image).quality(90).auto('format')
  if (kind === 'pair') {
    return builder.width(1600).height(1600).fit('crop').url()
  }
  return builder.width(3840).fit('max').url()
}
---

{
  renderRows.length > 0 && (
    <section class='col-span-full' aria-label='Project gallery'>
      <div class='space-y-8'>
        {renderRows.map((row) => (
          <div class={row.kind === 'pair' ? 'grid grid-cols-1 gap-4 md:grid-cols-2' : undefined}>
            {row.images.map((image) => (
              <figure class='space-y-4'>
                <img
                  src={imageUrl(image, row.kind)}
                  alt={image.alt || ''}
                  class={
                    row.kind === 'pair'
                      ? 'aspect-square w-full rounded-xl object-cover'
                      : 'h-auto w-full rounded-xl'
                  }
                  loading='lazy'
                  decoding='async'
                />
                {image.caption && (
                  <Text variant='caption' color='muted' class='text-center'>
                    {image.caption}
                  </Text>
                )}
              </figure>
            ))}
          </div>
        ))}
      </div>
    </section>
  )
}
