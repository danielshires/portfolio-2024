---
import HeroStatus from './HeroStatus'
import Text from '../../ui/text/Text.astro'
import { heroDisplayIntroClass, heroIdentityLabelClass, simpleHeroSectionClass } from '../../ui/text/styles'

interface Props {
  name: string
  intro: string
  /** Context under the headline (current role, way of working). Should not restate the headline. */
  supporting?: string
  avatar?: string
  /** Homepage only: pulsing availability, place, weather, and local time around the name. */
  localStatus?: boolean
}

const { name, intro, supporting, avatar, localStatus } = Astro.props

/** Collapsed whitespace length — above this, headline spans ~80% of the content column for long quotes. */
const LONG_INTRO_CHAR_THRESHOLD = 96
const introMeasure = intro.replace(/\s+/g, ' ').trim()
const heroIntroColumnClass =
  introMeasure.length > LONG_INTRO_CHAR_THRESHOLD ? 'max-w-[80%]' : 'max-w-4xl'

const exploreProjectsClass = [
  'inline-flex items-center rounded-lg px-3.5 py-2 text-sm font-normal',
  'bg-zinc-900 text-zinc-50 hover:bg-zinc-800',
  'dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700',
  'transition-colors duration-200',
  'outline-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2 dark:focus-visible:ring-white',
].join(' ')

const getInTouchClass = [
  'inline-flex items-center rounded-lg border px-3.5 py-2 text-sm font-normal',
  'border-zinc-300 bg-transparent text-zinc-700 hover:border-zinc-400 hover:bg-zinc-50',
  'dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:bg-zinc-900',
  'transition-colors duration-200',
  'outline-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2 dark:focus-visible:ring-white',
].join(' ')
---

<section
  id='intro'
  class={`${simpleHeroSectionClass} items-start`}
  aria-label='Introduction'>
  {
    avatar && (
      <img
        src={avatar}
        alt={name ? `${name} avatar` : 'Avatar'}
        width='48'
        height='48'
        decoding='async'
        loading='eager'
        class='size-12 shrink-0 rounded-full object-cover'
      />
    )
  }
  {
    name && (
      <p class:list={[heroIdentityLabelClass, avatar ? 'mt-4' : undefined]}>
        {localStatus ? <HeroStatus name={name} client:load /> : name}
      </p>
    )
  }
  <h1 class:list={[heroDisplayIntroClass, heroIntroColumnClass]}>
    {intro}
  </h1>
  {
    supporting && (
      <Text variant='lead' color='muted' class='mt-6 max-w-2xl md:mt-8'>
        {supporting}
      </Text>
    )
  }
  <div class='mt-8 flex flex-wrap items-center gap-2 md:mt-10'>
    <a href='/projects' class={exploreProjectsClass} data-swup-preload>
      Explore projects
    </a>
    <a
      href='mailto:hello@danielshires.com?subject=Portfolio%20Inquiry'
      class={getInTouchClass}
      aria-label='Send email to Daniel Shires'>
      Get in touch
    </a>
  </div>
</section>
