---
// Index of project page layout prototypes. Not linked from the site.
import Layout from '../../../layouts/Layout.astro'
import Text from '../../../components/ui/text/Text.astro'
import { getAllProjects } from '../../../lib/sanity'
import { sectionLabelTypographyClass } from '../../../components/ui/text/styles'
import { features } from '../../../config/features'

if (!features.experiments.enabled) {
  return Astro.redirect('/404')
}

const projects = (await getAllProjects()).filter((p) => p.slug?.current && p.linkBehavior !== 'external')
const variants = [
  { key: 'visual', name: 'Visuals first', note: 'Every project leads with the work: title, summary, impact and strong visuals. Key projects add a “Read the full story” link to a separate case study page with a section menu.' },
  { key: 'mixed', name: 'Mixed', note: 'The rail for case studies and the hero for visual work, picked per project.' },
  { key: 'hero', name: 'A · Hero', note: 'Inset rounded image first, then title and meta side by side, impact as a band. Visual projects collapse the brief into two short columns and go straight to the work.' },
  { key: 'rail', name: 'B · Rail', note: 'Sticky “On this page” rail that tracks the section in view, with impact figures pinned underneath. Becomes a sticky scrolling tab strip on mobile.' },
  { key: 'story', name: 'C · Story', note: 'Wildcard: a pinned visual on the left that cross-fades as you read the chapters on the right. Captions become chapters, so it works for galleries and write-ups alike.' },
]
---

<Layout pageTitle='Project layout prototypes | Daniel Shires' pageDescription='Project page layout prototypes.' robots='noindex,follow'>
  <section class='mt-28 md:mt-36 mb-20 max-w-5xl'>
    <Text variant='h1' class='mb-4'>Project page prototypes</Text>
    <Text variant='lead' color='muted' class='mb-16 max-w-2xl'>Three layouts, each rendered against every project, so you can compare case studies with visual work.</Text>
    <div class='space-y-14'>
      {variants.map((v) => (
        <div class='border-t border-zinc-200 pt-6 dark:border-zinc-800'>
          <Text variant='h2'>{v.name}</Text>
          <Text variant='body' color='muted' class='mt-2 max-w-2xl'>{v.note}</Text>
          <ul class='mt-5 flex flex-wrap gap-2'>
            {projects.map((p) => (
              <li>
                <a href={`/playground/project-layouts/${v.key}/${p.slug.current}`} class='inline-block rounded-full border border-zinc-200 px-3 py-1.5 text-sm hover:border-zinc-900 dark:border-zinc-800 dark:hover:border-zinc-100'>
                  {p.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class={`${sectionLabelTypographyClass} mt-16`}>Case studies: Formbay Explains, Formbay Research Repository · Visual: MASO, Formbay brand, Scenic</p>
  </section>
</Layout>
