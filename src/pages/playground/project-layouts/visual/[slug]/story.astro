---
// "Read the full story" page for the Visuals first prototype: the case study write-up, with a section rail.
import { PortableText } from 'astro-portabletext'
import Layout from '../../../../../layouts/Layout.astro'
import { getAllProjects, getProjectBySlug, caseStudyFigureLabels } from '../../../../../lib/sanity'
import CaseStudyImage from '../../../../../components/content/projects/CaseStudyImage.astro'
import SiteChildNav from '../../../../../components/layout/navigation/SiteChildNav.astro'
import Text from '../../../../../components/ui/text/Text.astro'
import { gridGutterClass, sectionLabelTypographyClass } from '../../../../../components/ui/text/styles'
import { features } from '../../../../../config/features'
import { storySections, hasFullStory, readMinutes, shortHeading, formatList, proseClass } from '../../_story'

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects
    .filter((project) => project.slug?.current && project.linkBehavior !== 'external')
    .map((project) => ({ params: { slug: project.slug.current } }))
}

if (!features.experiments.enabled) {
  return Astro.redirect('/404')
}

const slug = Astro.params.slug!
const project = await getProjectBySlug(slug)
const sections = project ? storySections(project) : []
if (!project || !hasFullStory(sections)) {
  return Astro.redirect(`/playground/project-layouts/visual/${slug}`)
}

const projectHref = `/playground/project-layouts/visual/${slug}`
const figureLabels = caseStudyFigureLabels(sections.map((s) => s.body))
const withFigureLabels = (body: (typeof sections)[number]['body']) =>
  body.map((block) => {
    const label = block._key ? figureLabels.get(block._key) : undefined
    return label ? { ...block, figureLabel: label } : block
  })
const ptComponents = { type: { image: CaseStudyImage } }

const year = project.publishedAt ? new Date(project.publishedAt).getFullYear() : undefined
const meta = [
  ['Client', project.client],
  ['Role', formatList(project.role)],
  ['Team', formatList(project.team)],
  ['Year', year],
].filter(([, value]) => value)
const backLinkClass =
  'group/back inline-flex items-baseline gap-2 text-base text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100'
---

<Layout pageTitle={`${project.title}: the full story | Layout prototype`} pageDescription='Project case study prototype.' robots='noindex,follow'>
  <header class='mt-28 md:mt-36 lg:mt-44 pb-12 md:pb-16'>
    <a href={projectHref} class={backLinkClass}>
      <span aria-hidden='true' class='transition-transform group-hover/back:-translate-x-1'>←</span> {project.title}
    </a>
    <p class={`${sectionLabelTypographyClass} mt-10`}>The full story · {readMinutes(sections)} min read</p>
    <Text variant='h1' class='mt-4 mb-4'>{project.title}</Text>
    {project.subtitle && <Text variant='lead' color='muted' class='max-w-2xl'>{project.subtitle}</Text>}
    <dl class='mt-10 flex flex-wrap gap-x-12 gap-y-6'>
      {meta.map(([label, value]) => (
        <div class='max-w-xs'>
          <dt class={sectionLabelTypographyClass}>{label}</dt>
          <dd class='mt-2'><Text variant='body'>{value}</Text></dd>
        </div>
      ))}
    </dl>
  </header>

  <div class={`grid grid-cols-1 lg:grid-cols-12 ${gridGutterClass} border-t border-zinc-200 pt-12 md:pt-16 mb-20 dark:border-zinc-800`} data-spy-root>
    <aside class='lg:col-span-3 sticky top-14 md:top-16 z-30 -mx-8 px-8 lg:mx-0 lg:px-0 lg:self-start lg:top-32 bg-white/90 backdrop-blur dark:bg-zinc-950/90 lg:bg-transparent lg:backdrop-blur-none lg:dark:bg-transparent'>
      <nav aria-label='On this page' class='py-3 lg:py-0'>
        <ol class='flex gap-5 overflow-x-auto whitespace-nowrap lg:flex-col lg:gap-0 lg:overflow-visible [scrollbar-width:none]'>
          {sections.map((s) => (
            <li>
              <a
                href={`#${s.id}`}
                data-spy-link={s.id}
                data-no-swup
                class='group/link relative flex items-baseline gap-2 py-1 text-base text-zinc-500 transition-[color,padding] duration-200 hover:text-zinc-900 data-[active]:text-zinc-900 lg:py-1.5 lg:data-[active]:pl-3 dark:text-zinc-400 dark:hover:text-zinc-100 dark:data-[active]:text-zinc-100'>
                <span aria-hidden='true' class='absolute left-0 top-1/2 hidden h-4 w-px -translate-y-1/2 bg-current opacity-0 transition-opacity group-data-[active]/link:opacity-100 lg:block' />
                {shortHeading(s.heading)}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>

    <div class='lg:col-span-9 min-w-0'>
      {sections.map((s, i) => (
        <section
          id={s.id}
          data-spy-section
          class:list={['scroll-mt-40 py-12 md:py-16', i > 0 ? 'border-t border-zinc-200 dark:border-zinc-800' : 'pt-0 md:pt-0']}>
          <p class={sectionLabelTypographyClass}>{String(i + 1).padStart(2, '0')}</p>
          <Text variant='h2' class='mt-3 mb-6'>{s.heading}</Text>
          <div class={`${proseClass} max-w-3xl`}>
            <PortableText value={withFigureLabels(s.body)} components={ptComponents} />
          </div>
        </section>
      ))}

      <a href={projectHref} class={`${backLinkClass} mt-4`}>
        <span aria-hidden='true' class='transition-transform group-hover/back:-translate-x-1'>←</span> Back to the project
      </a>
    </div>
  </div>

  <SiteChildNav parentHref='/playground/project-layouts' parentLabel='Layout prototypes' layout='full' />
</Layout>

<script>
  import '../../_rail-spy'
</script>
