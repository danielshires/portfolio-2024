---
import '../../styles/tailwind.css'
import 'streamdown/styles.css'
import AvatarChat from '../../components/content/experiments/AvatarChat.tsx'
import { features } from '../../config/features'

if (!features.experiments.enabled) {
  return Astro.redirect('/404')
}

const pageTitle = 'Digital avatar'
const pageDescription =
  'A chat with a digital avatar grounded in the public pages on this site.'
---

<!doctype html>
<html lang='en' class='dark'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex,follow' />
    <meta name='description' content={pageDescription} />
    <title>{pageTitle}</title>
    <link href='https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&display=swap' rel='stylesheet' />
  </head>
  <body>
    <AvatarChat client:load />
  </body>
</html>

<style is:global>
  html,
  body {
    height: 100%;
    margin: 0;
    background-color: #1e1e1e;
  }

  astro-island {
    display: block;
    height: 100vh;
  }

  /* shadcn / AI Elements tokens in the playground's greys (the page is always dark). */
  .studio {
    --background: #1e1e1e;
    --foreground: #ffffff;
    --card: #2c2c2c;
    --card-foreground: #ffffff;
    --popover: #2c2c2c;
    --popover-foreground: #ffffff;
    --primary: #ffffff;
    --primary-foreground: #1e1e1e;
    --secondary: rgba(255, 255, 255, 0.12);
    --secondary-foreground: #ffffff;
    --muted: rgba(255, 255, 255, 0.06);
    --muted-foreground: rgba(255, 255, 255, 0.55);
    --accent: rgba(255, 255, 255, 0.1);
    --accent-foreground: #ffffff;
    --border: rgba(255, 255, 255, 0.12);
    --input: rgba(255, 255, 255, 0.12);
    --ring: rgba(255, 255, 255, 0.45);
  }

  .studio {
    display: flex;
    flex-direction: row;
    height: 100%;
    margin: 0;
    background-color: #1e1e1e;
    color: white;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
  }

  .studio-stage {
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .studio-controls {
    width: 250px;
    flex-shrink: 0;
    transition: width 0.25s ease, padding 0.25s ease;
    align-self: stretch;
    padding: 20px;
    margin: 2rem;
    border-radius: 1rem;
    background-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .studio-controls h1,
  .studio-controls p,
  .studio-avatar p {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
  }

  .studio-controls h1 {
    font-size: 14px;
  }

  .studio-new {
    background-color: #282828;
    border: none;
    color: white;
    padding: 8px 10px;
    border-radius: 4px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
    cursor: pointer;
  }

  .studio-new {
    width: 100%;
  }

  .studio-new:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .studio-history {
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow-y: auto;
    min-height: 0;
    margin: 0 -8px;
    padding: 0 8px;
  }

  .studio-history-group h2 {
    margin: 0 0 4px 8px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-weight: 400;
  }

  .studio-history-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .studio-history-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .studio-history .studio-history-open {
    display: flex;
    flex-direction: column;
    gap: 1px;
    width: 100%;
    min-width: 0;
    text-align: left;
    background: transparent;
    border: none;
    color: white;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
    line-height: 1.45;
    /* Room on the right for the delete button. */
    padding: 6px 32px 6px 8px;
    border-radius: 6px;
    cursor: pointer;
  }

  .studio-history .studio-history-open:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .studio-history-title,
  .studio-history-snippet {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .studio-history-snippet {
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
  }

  .studio-new {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .studio-new kbd {
    color: rgba(255, 255, 255, 0.45);
    font-family: inherit;
    font-size: 12px;
  }

  .studio-rail-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    cursor: pointer;
  }

  .studio-rail-toggle:hover {
    color: white;
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* Desktop: the chat list folded down to a slim rail with just its buttons. */
  .studio-controls-rail {
    width: 64px;
    padding: 16px 12px;
    align-items: center;
  }

  .studio-controls-rail .studio-controls-header {
    justify-content: center;
  }

  .studio-controls-rail .studio-new {
    width: 40px;
    height: 40px;
    padding: 0;
  }

  .message-note {
    color: rgba(255, 255, 255, 0.45);
    font-size: 13px;
    padding: 2px 0;
  }

  .studio-history button[aria-current='true'] {
    background-color: #282828;
  }

  .studio-history .studio-history-delete {
    position: absolute;
    right: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    opacity: 0;
  }

  .studio-history-item:hover .studio-history-delete,
  .studio-history-item:focus-within .studio-history-delete {
    opacity: 1;
  }

  .studio-history .studio-history-delete:hover {
    color: white;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .studio-history .studio-history-delete:disabled {
    opacity: 0;
    pointer-events: none;
  }

  /* No hover on touch screens: keep delete visible. */
  @media (hover: none) {
    .studio-history .studio-history-delete {
      opacity: 1;
    }
  }

  .studio-toast {
    position: fixed;
    left: 50%;
    bottom: 96px;
    transform: translateX(-50%);
    z-index: 300;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 14px;
    border-radius: 999px;
    background-color: #2c2c2c;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    font-size: 13px;
  }

  .studio-toast button {
    border: none;
    border-radius: 999px;
    padding: 4px 10px;
    background-color: white;
    color: #1e1e1e;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    cursor: pointer;
  }

  .studio-controls button:focus-visible,
  .studio-stage button:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.45);
    outline-offset: 2px;
  }

  .studio-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .studio-overlay {
    display: none;
  }

  .studio-menu-toggle {
    display: none;
  }

  .studio-close {
    display: none;
  }

  .studio-controls-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .studio-controls-header h1 {
    flex: 1;
  }

  /* Avatar header, pinned above the thread (centred and larger on an empty chat). */
  .studio-avatar {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(100%, 40rem);
    margin-inline: auto;
    padding: 1.25rem 2rem 0.75rem;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .studio-stage[data-empty] .studio-avatar {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    gap: 16px;
  }

  .studio-avatar-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .studio-avatar-name {
    color: white;
  }

  .studio-avatar-status {
    color: rgba(255, 255, 255, 0.55);
  }

  .studio-avatar .studio-empty {
    max-width: 32rem;
    color: rgba(255, 255, 255, 0.72);
  }

  /* The frame takes the layout size; the avatar inside renders at a fixed size and scales. */
  .chat-avatar-frame {
    position: relative;
    flex-shrink: 0;
    transition: width 0.35s ease, height 0.35s ease;
  }

  .chat-avatar {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0;
    border: none;
    border-radius: 50%;
    overflow: hidden;
    background-color: #2c2c2c;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    cursor: pointer;
    transform-origin: top left;
    transition: transform 0.35s ease;
  }

  .chat-avatar > div {
    position: absolute !important;
    inset: 0;
  }

  .chat-avatar-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s;
  }

  
  .studio-composer {
    padding: 0 2rem 2rem;
    box-sizing: border-box;
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-avatar-frame,
    .chat-avatar,
    .chat-avatar-poster {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .studio {
      flex-direction: column;
    }

    .studio-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 200;
      -webkit-backdrop-filter: blur(2px);
      backdrop-filter: blur(2px);
    }

    .studio-controls {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(280px, 85vw);
      max-height: none;
      margin: 0;
      border-radius: 0;
      z-index: 210;
      transform: translateX(-100%);
      transition: transform 0.25s ease;
    }

    .studio-controls-open {
      transform: translateX(0);
    }

    .studio-stage {
      position: relative;
      z-index: 1;
    }

    .studio-rail-toggle {
      display: none;
    }

    .studio-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: transparent;
      border: none;
      color: white;
      cursor: pointer;
      border-radius: 4px;
      margin: -4px -4px -4px 0;
    }

    .studio-close:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .studio-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      width: 40px;
      height: 40px;
      background: rgba(255, 255, 255, 0.1);
      border: none;
      color: white;
      cursor: pointer;
      border-radius: 8px;
      z-index: 10;
      -webkit-tap-highlight-color: transparent;
    }

    .studio-menu-toggle:hover {
      background: rgba(255, 255, 255, 0.16);
    }

    .studio-menu-toggle:focus-visible {
      outline: 1px solid rgba(255, 255, 255, 0.45);
      outline-offset: 2px;
    }

    .studio-stage {
      min-height: 0;
    }

    .studio-avatar {
      padding: 0.75rem 0.75rem 0.5rem 3.75rem;
    }

    .studio-stage[data-empty] .studio-avatar {
      padding: 4rem 1rem 1rem;
    }

    .studio-composer {
      padding: 0 0.75rem 0.75rem;
    }
  }
</style>
