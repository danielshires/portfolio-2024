---
import Layout from '../layouts/Layout.astro'
import SimpleHero from '../components/content/featured/SimpleHero.astro'
import { features } from '../config/features'
import ExternalLinkGlyph from '../components/ui/icons/ExternalLinkGlyph.astro'
import {
  externalLinkGlyphGroupHoverClass,
  linkListMutedContinuationClass,
  linkListParagraphClass,
  linkListRowAnchorClass,
  linkListStrongTitleClass,
} from '../components/ui/text/styles'

if (!features.experiments.enabled) {
  return Astro.redirect('/404')
}

const pageTitle = 'Playground | Daniel Shires'
const pageDescription = 'Prototypes and experiments.'

const experiments = [
  {
    title: 'Digital avatar',
    href: '/playground/avatar',
    description:
      'A chat grounded in the public pages on this site. Ask it about my work, writing or experience instead of browsing for it.',
  },
  {
    title: 'spinnerstudio',
    href: '/playground/spinnerstudio',
    description:
      'A generative shape playground. Adjust shape, count, colour and motion to see how a few parameters produce very different patterns.',
  },
]
---

<Layout pageTitle={pageTitle} pageDescription={pageDescription} robots='noindex,follow'>
  <article class='pb-16 md:pb-24'>
    <SimpleHero
      introText={{
        first: 'Playground',
        second: 'Prototypes and experiments',
      }}
    />

    <section class='mt-10 flex max-w-3xl flex-col md:mt-12' aria-label='Experiment list'>
      {
        experiments.map((experiment) => (
          <a
            href={experiment.href}
            class={linkListRowAnchorClass}
            aria-label={`${experiment.title} (opens in new tab)`}
            target='_blank'
            rel='noopener noreferrer'>
            <p class={linkListParagraphClass}>
              <span class={linkListStrongTitleClass}>{experiment.title}</span>{' '}
              <span class={linkListMutedContinuationClass}>{experiment.description}</span>{' '}
              <ExternalLinkGlyph
                class={`relative top-[0.03em] h-[0.72em] w-[0.72em] align-middle ${externalLinkGlyphGroupHoverClass}`}
              />
            </p>
          </a>
        ))
      }
    </section>
  </article>
</Layout>
