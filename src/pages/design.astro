---
import Layout from '../layouts/Layout.astro'
import ProjectGrid from '../components/content/projects/ProjectGrid.astro'
import SimpleHero from '../components/content/featured/SimpleHero.astro'
import { getAllProjects } from '../lib/sanity'
import PageTransition from '../components/layout/transitions/PageTransition.astro'

const projects = await getAllProjects()

const heroContent = {
  introText: {
    first: 'Projects',
    second: 'Case studies from discovery through delivery.',
  },
}

// SEO optimized content
const pageTitle = 'Design Portfolio | Daniel Shires'
const pageDescription =
  'Product design case studies, from discovery through delivery. Senior Product Designer at Commonwealth Bank in Sydney.'
const pageImage = '/images/jpg/background.webp'

// Structured data for design portfolio
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Design Portfolio',
  description: pageDescription,
  url: 'https://danielshires.com/design',
  image: new URL(pageImage, 'https://danielshires.com').href,
  author: {
    '@type': 'Person',
    name: 'Daniel Shires',
    jobTitle: 'Senior Product Designer',
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.slice(0, 10).map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'CreativeWork',
        name: project.title,
        description: project.subtitle || 'Design project by Daniel Shires',
        url: `https://danielshires.com/projects/${project.slug.current}`,
        creator: {
          '@type': 'Person',
          name: 'Daniel Shires',
        },
        dateCreated: project.publishedAt,
        keywords: project.tags?.join(', ') || 'UX Design, UI Design, Product Design',
      },
    })),
  },
}
---

<Layout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageImage={pageImage}
  jsonLd={structuredData}
  pageType='website'>
  <PageTransition>
    <div class='flex flex-col'>
      <SimpleHero {...heroContent} />
      <ProjectGrid projects={projects} />
    </div>
  </PageTransition>
</Layout>
