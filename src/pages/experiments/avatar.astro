---
import AvatarChat from '../../components/content/experiments/AvatarChat.tsx'
import { features } from '../../config/features'

if (!features.experiments.enabled) {
  return Astro.redirect('/404')
}

const pageTitle = 'Digital avatar'
const pageDescription =
  'A chat with a digital avatar grounded in the public pages on this site.'
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex,follow' />
    <meta name='description' content={pageDescription} />
    <title>{pageTitle}</title>
    <link href='https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&display=swap' rel='stylesheet' />
  </head>
  <body>
    <AvatarChat client:load />
  </body>
</html>

<style is:global>
  html,
  body {
    height: 100%;
    margin: 0;
    background-color: #1e1e1e;
  }

  astro-island {
    display: block;
    height: 100vh;
  }

  .studio {
    display: flex;
    flex-direction: row;
    height: 100%;
    margin: 0;
    background-color: #1e1e1e;
    color: white;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
  }

  .studio-result {
    flex: 1;
    min-width: 0;
    height: 100%;
    overflow-y: auto;
    padding: 2rem;
    box-sizing: border-box;
  }

  .studio-controls {
    width: 250px;
    padding: 20px;
    margin: 2rem;
    border-radius: 1rem;
    background-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }

  .studio-controls h1,
  .studio-controls p,
  .studio-result p {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
  }

  .studio-controls h1 {
    font-size: 14px;
  }

  .studio-note {
    color: rgba(255, 255, 255, 0.72);
  }

  .studio-controls textarea,
  .studio-controls button {
    margin: 5px 0;
    background-color: #282828;
    border: none;
    color: white;
    padding: 5px;
    border-radius: 4px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
  }

  .studio-controls textarea {
    width: 100%;
    min-height: 8rem;
    resize: vertical;
    box-sizing: border-box;
  }

  .studio-controls textarea::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .studio-controls button {
    cursor: pointer;
    width: 100%;
  }

  .studio-controls button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .studio-message p {
    white-space: pre-wrap;
  }

  .studio-message + .studio-message {
    margin-top: 16px;
  }

  .studio-label {
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 4px;
  }

  @media (max-width: 768px) {
    .studio {
      flex-direction: column;
    }

    .studio-result {
      order: -1;
      height: 300px;
      flex: none;
    }

    .studio-controls {
      width: auto;
    }
  }
</style>
