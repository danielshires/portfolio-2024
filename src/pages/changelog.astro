---
import Layout from '../layouts/Layout.astro'
import SimpleHero from '../components/content/featured/SimpleHero.astro'
import SiteChangelog from '../components/content/changelog/Changelog'
import { getChangelog } from '../lib/changelog'

const days = getChangelog()
const pageTitle = 'Changelog | Daniel Shires'
const pageDescription = 'Site updates, one build for each day.'
---

<Layout pageTitle={pageTitle} pageDescription={pageDescription}>
  <article class='pb-16 md:pb-24'>
    <SimpleHero
      introText={{
        first: 'Changelog',
        second: 'Site updates, one build for each day.',
      }}
    />

    <section class='mt-10 max-w-3xl md:mt-12' aria-label='Changelog'>
      <SiteChangelog days={days} client:load />
    </section>
  </article>
</Layout>
