---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/content/featured/Hero.astro'
import WritingPreview from '../components/content/posts/WritingPreview.astro'
import ProjectGrid from '../components/content/projects/ProjectGrid.astro'
import Experience from '../components/content/experience/Experience.astro'
import { stackBelowHeroClass } from '../components/ui/text/styles'
import { getAuthorBySlug, getAllProjects, getFeaturedProjects, getAllPosts, urlFor } from '../lib/sanity'
import { applySanityPageCache } from '../lib/sanityPageCache'
import { PERSON_NODE_ID, SITE_ORIGIN, siteOwnerSameAs } from '../lib/seo/merge-global-jsonld'

// On-request so the writing preview tracks Sanity without a rebuild.
export const prerender = false

const author = await getAuthorBySlug('daniel-shires')
applySanityPageCache(Astro.response.headers)
const avatarUrl = author?.image ? urlFor(author.image).width(192).height(192).url() : undefined

const heroContent = {
  name: 'Daniel Shires',
  localStatus: true,
  intro: `Product designer focused 
  on discovery, systems and 
  human behaviour.`,
  supporting:
    'Currently shaping the future of customer communication at Commonwealth Bank. I combine product discovery, systems thinking and AI-assisted development to turn complex problems into delightful digital experiences.',
  ...(avatarUrl !== undefined ? { avatar: avatarUrl } : {}),
}

// Thinking out loud (posts) for homepage preview
const allPosts = await getAllPosts()

// Get projects from Sanity
const allProjects = await getAllProjects()
const featuredProjects = await getFeaturedProjects()

// Use featured projects if available, otherwise show all projects
const projectsToShow = featuredProjects.length > 0 ? featuredProjects : allProjects

// SEO optimized content
const pageTitle = 'Daniel Shires | Senior Product Designer | Sydney'
const pageDescription =
  'Senior Product Designer in Sydney at Commonwealth Bank. Shaping complex digital products in financial services, from discovery through delivery.'
const pageImage = avatarUrl || '/images/jpg/background.webp'
const pageImageAbsolute = new URL(pageImage, SITE_ORIGIN).href

// Structured data for the homepage
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_NODE_ID,
  name: 'Daniel Shires',
  jobTitle: 'Senior Product Designer',
  url: SITE_ORIGIN,
  image: pageImageAbsolute,
  description: pageDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sydney',
    addressCountry: 'AU',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Commonwealth Bank',
  },
  knowsAbout: [
    'Product design',
    'Product discovery',
    'Design systems',
    'Accessibility',
    'Customer-centred design',
    'Photography',
  ],
  sameAs: siteOwnerSameAs(),
}
---

<Layout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageImage={pageImageAbsolute}
  jsonLd={structuredData}
  pageType='website'>
  {/* px/mx inset the clip box so the availability pulse can expand past the dot. */}
  <div class='-mx-2 grid h-max gap-8 overflow-hidden px-2 pb-16 md:pb-24'>
    <Hero {...heroContent} />
    <ProjectGrid projects={projectsToShow} variant='featured' />
    {/* <ProjectGrid projects={projectsToShow} variant='text' /> */}
    <WritingPreview posts={allPosts} />
    <Experience class={stackBelowHeroClass} />
  </div>
</Layout>
